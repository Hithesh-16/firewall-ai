{
  "name": "ai-firewall",
  "icon": "media/icon.png",
  "author": "AI Firewall Inc",
  "version": "1.3.33",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-firewall/ai-firewall"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "bugs": {
    "url": "https://github.com/ai-firewall/ai-firewall/issues",
    "email": "hello@ai-firewall.dev"
  },
  "homepage": "https://ai-firewall.dev",
  "qna": "https://github.com/ai-firewall/ai-firewall/issues/new/choose",
  "license": "Apache-2.0",
  "displayName": "AI Firewall - AI code agent",
  "pricing": "Free",
  "description": "The leading open-source AI code agent",
  "publisher": "ai-firewall",
  "engines": {
    "vscode": "^1.70.0",
    "node": ">=20.19.0"
  },
  "engine-strict": true,
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "chatgpt",
    "cline",
    "roo",
    "github",
    "copilot",
    "claude",
    "mistral",
    "codestral",
    "ai"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished",
    "onView:aiFirewallGUIView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "aiFirewallGetStarted",
        "title": "Get Started with AI Firewall",
        "description": "Learn the key features of AI Firewall — security scanning, token intelligence, and approval workflows.",
        "steps": [
          {
            "id": "chat",
            "title": "Chat with AI",
            "description": "Open the sidebar and start chatting. Ask questions, get code suggestions, and let the agent use tools.\n\n[Open AI Firewall](command:aiFirewall.focusContinueInput)",
            "media": {
              "markdown": "Every message is scanned for secrets and PII before reaching the LLM."
            }
          },
          {
            "id": "security",
            "title": "Security Scanning",
            "description": "AI Firewall scans every request through 6 scanners: secrets, PII, entropy, prompt injection, context-aware severity, and policy engine.\n\nLook for the shield icon in the status bar — it shows scan results in real-time.",
            "media": {
              "markdown": "**12 secret patterns** (AWS keys, JWTs, DB URLs) + **7 PII patterns** (email, SSN, credit card) + **13 injection categories**"
            }
          },
          {
            "id": "tokens",
            "title": "Token Intelligence",
            "description": "Every response shows real token counts and cost. The context reducer can save up to 75% of tokens by stripping comments and irrelevant code.\n\nCheck the response headers: `X-AF-Input-Tokens`, `X-AF-Estimated-Cost`.",
            "media": {
              "markdown": "Real tiktoken counting — not character heuristics. See exactly what you're spending."
            }
          },
          {
            "id": "tools",
            "title": "Agent Tools",
            "description": "The AI can read files, search your codebase, run terminal commands, and more — all through the firewall.\n\n26 built-in tools, each with configurable permission policies.",
            "media": {
              "markdown": "Tools like `read_file`, `grep_search`, `run_terminal_command` all pass through scanning."
            }
          },
          {
            "id": "approvals",
            "title": "Permission Control",
            "description": "You approve every file access and tool use. High-risk actions show a prominent permission card with the reason and risk level.\n\nKeyboard shortcuts: **Cmd+Enter** to Accept, **Cmd+Backspace** to Reject.",
            "media": {
              "markdown": "Accept/Reject every tool call. Or set tools to auto-approve in Settings > Tools."
            }
          }
        ]
      }
    ],
    "languages": [
      {
        "filenames": [
          "config.json",
          ".ai-firewallrc.json"
        ],
        "id": "jsonc"
      },
      {
        "id": "promptLanguage",
        "extensions": [
          ".prompt"
        ],
        "aliases": [
          "Prompt Language"
        ],
        "configuration": "./prompt-file-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "promptLanguage",
        "scopeName": "source.prompt",
        "path": "./media/prompt.tmLanguage.json"
      }
    ],
    "authentication": [
      {
        "id": "ai-firewall",
        "label": "AI Firewall"
      }
    ],
    "configuration": {
      "title": "AI Firewall",
      "properties": {
        "aiFirewall.telemetryEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "AI Firewall collects anonymous usage data, cleaned of PII, to help us improve the product. Telemetry can be fully disabled.",
          "markdownDeprecationMessage": "This setting is deprecated and will be removed in a later version. Please use the _Telemetry > Allow Anonymous Telemetry_ setting in the extension's User Settings page.",
          "deprecationMessage": "Please use the _Telemetry > Allow Anonymous Telemetry_ setting in the extension's User Settings page."
        },
        "aiFirewall.showInlineTip": {
          "type": "boolean",
          "default": true,
          "description": "Show inline suggestion to use the AI Firewall keyboard shortcuts (e.g. \"Cmd/Ctrl L to select code, Cmd/Ctrl I to edit\")."
        },
        "aiFirewall.disableQuickFix": {
          "type": "boolean",
          "default": false,
          "description": "Disable the quick fix feature."
        },
        "aiFirewall.enableQuickActions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable the experimental Quick Actions feature. Read our walkthrough to learn about configuration and how to share feedback: [AI Firewall Docs › Quick Actions](https://docs.ai-firewall.dev/customize/deep-dives/vscode-actions#quick-actions)"
        },
        "aiFirewall.enableTabAutocomplete": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable AI Firewall's tab autocomplete feature. Read our walkthrough to learn about configuration and how to share feedback: [AI Firewall Docs › Tab Autocomplete](https://docs.ai-firewall.dev/features/tab-autocomplete)"
        },
        "aiFirewall.enableNextEdit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable AI Firewall's next edit feature. Read our docs to learn about configuration and how to share feedback: [AI Firewall Docs › Next Edit](https://docs.ai-firewall.dev/features/autocomplete/next-edit)"
        },
        "aiFirewall.pauseTabAutocompleteOnBattery": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Pause AI Firewall's tab autocomplete feature when your battery is low."
        },
        "aiFirewall.pauseCodebaseIndexOnStart": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Pause AI Firewall's codebase index on start."
        },
        "aiFirewall.enableConsole": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable a console to log and explore model inputs and outputs. It can be found in the bottom panel."
        },
        "aiFirewall.remoteConfigServerUrl": {
          "type": "string",
          "default": null,
          "markdownDescription": "If your team is set up to use shared configuration, enter the server URL here and your user token below to enable automatic syncing."
        },
        "aiFirewall.userToken": {
          "type": "string",
          "default": null,
          "markdownDescription": "If your team is set up to use shared configuration, enter your user token here and your server URL above to enable automatic syncing."
        },
        "aiFirewall.remoteConfigSyncPeriod": {
          "type": "number",
          "default": 60,
          "description": "The period of time in minutes between automatic syncs."
        }
      }
    },
    "commands": [
      {
        "command": "aiFirewall.applyCodeFromChat",
        "category": "AI Firewall",
        "title": "Apply code from chat",
        "icon": "$(run)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.acceptDiff",
        "category": "AI Firewall",
        "title": "Accept Diff",
        "icon": "$(check)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.rejectDiff",
        "category": "AI Firewall",
        "title": "Reject Diff",
        "icon": "$(close)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.acceptVerticalDiffBlock",
        "category": "AI Firewall",
        "title": "Accept Vertical Diff Block",
        "icon": "$(diff-added)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.rejectVerticalDiffBlock",
        "category": "AI Firewall",
        "title": "Reject Vertical Diff Block",

        "icon": "$(terminal)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.exitEditMode",
        "category": "AI Firewall",
        "title": "Exit Edit Mode",
        "icon": "$(arrow-left)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.openConfigPage",
        "category": "AI Firewall",
        "title": "Open Settings",
        "icon": "$(settings-gear)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.toggleTabAutocompleteEnabled",
        "category": "AI Firewall",
        "title": "Toggle Autocomplete Enabled",
        "icon": "$(sparkle)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.forceAutocomplete",
        "title": "AI Firewall: Force Autocomplete",
        "icon": "$(zap)",
        "category": "AI Firewall"
      },
      {
        "command": "aiFirewall.selectFilesAsContext",
        "category": "AI Firewall",
        "title": "Select Files as Context",
        "icon": "$(files)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.newSession",
        "category": "AI Firewall",
        "title": "New Session",
        "icon": "$(new-file)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.shareSession",
        "category": "AI Firewall",
        "title": "Share Current Chat Session as Markdown",
        "icon": "$(export)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.viewHistory",
        "category": "AI Firewall",
        "title": "View History",
        "icon": "$(history)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.viewLogs",
        "category": "AI Firewall",
        "title": "View Logs",
        "icon": "$(output)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.clearConsole",
        "category": "AI Firewall",
        "title": "Clear Console",
        "icon": "$(clear-all)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.navigateTo",
        "category": "AI Firewall",
        "title": "Navigate to a path",
        "icon": "$(go-to-file)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.writeCommentsForCode",
        "category": "AI Firewall",
        "title": "Write Comments for this Code",
        "icon": "$(comment)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.writeDocstringForCode",
        "category": "AI Firewall",
        "title": "Write a Docstring for this Code",

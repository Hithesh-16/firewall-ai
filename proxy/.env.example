 # AI Firewall Proxy Configuration
# Copy this file to .env and fill in the values

# Server
PORT=8080
DB_PATH=./data/firewall.db

# Legacy provider (used when no provider is registered via API)
PROVIDER_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=8684fc359779c10f1d133dcd4faf0f411abca40a92189475c748a44e3d09797e

# Generate: openssl rand -hex 32
MASTER_KEY=

# Local LLM (Ollama)
# LOCAL_LLM_URL=http://localhost:11434

# Strict local mode (block all cloud providers)
# STRICT_LOCAL=false

# SSO Authentication (optional)
SSO_PROVIDER=google          # google | github | microsoft | oidc
SSO_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SSO_CLIENT_SECRET=your-google-client-secret
SSO_REDIRECT_URI=http://localhost:8080/api/auth/sso/callback
# SSO_ISSUER_URL=              # Required for generic OIDC

# Scheduled compliance reports
# REPORT_INTERVAL_HOURS=168    # 168 = weekly, 0 = disabled

# ── Agent web research (research_web + search_web tools) ─────────────
# The proxy exposes POST /v1/web-search and POST /v1/web-extract.
# Configure ONE of the three providers below — first key found wins.
#
# Tavily is the recommended choice: it returns clean markdown content
# out of the box (used for both search AND extract), has a generous
# free tier, and matches Anthropic's recommended agent-search API.
#
# Without any key set, /v1/web-search returns a helpful "not configured"
# message (safe 200, not an error) and /v1/web-extract falls back to
# direct HTTP fetch with raw HTML passthrough.
# TAVILY_API_KEY=tvly-...
# BRAVE_SEARCH_API_KEY=...
# SERPAPI_API_KEY=...

# Override the URL the core fetches /v1/web-search from. Defaults to
# http://127.0.0.1:8080 (this proxy). Only set if the proxy runs on
# a non-local host or non-default port.
# AI_FIREWALL_PROXY_URL=http://127.0.0.1:8080

# AI Firewall Proxy Configuration
# Copy this file to .env and fill in the values

# Server
PORT=8080
DB_PATH=./data/firewall.db

# Legacy provider (used when no provider is registered via API)
PROVIDER_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=

# Vault encryption key (required for provider API key storage)
# Generate: openssl rand -hex 32
MASTER_KEY=

# Local LLM (Ollama)
# LOCAL_LLM_URL=http://localhost:11434

# Strict local mode (block all cloud providers)
# STRICT_LOCAL=false

# SSO Authentication (optional)
SSO_PROVIDER=google          # google | github | microsoft | oidc
SSO_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SSO_CLIENT_SECRET=your-google-client-secret
SSO_REDIRECT_URI=http://localhost:8080/api/auth/sso/callback
# SSO_ISSUER_URL=              # Required for generic OIDC

# Scheduled compliance reports
# REPORT_INTERVAL_HOURS=168    # 168 = weekly, 0 = disabled

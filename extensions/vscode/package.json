      },
      {
        "command": "aiFirewall.nextEditWindow.acceptNextEditSuggestion",
        "category": "AI Firewall",
        "title": "Accept Next Edit Suggestion",
        "icon": "$(check)"
      },
      {
        "command": "aiFirewall.forceNextEdit",
        "category": "AI Firewall",
        "title": "AI Firewall: Force Next Edit",
        "icon": "$(arrow-right)"
      },
      {
        "command": "aiFirewall.toggleScanning",
        "category": "AI Firewall",
        "title": "AI Firewall: Toggle Security Scanning"
      },
      {
        "command": "aiFirewall.showRiskScore",
        "category": "AI Firewall",
        "title": "AI Firewall: Show Risk Score"
      },
      {
        "command": "aiFirewall.viewDashboard",
        "category": "AI Firewall",
        "title": "AI Firewall: Open Security Dashboard"
      },
      {
        "command": "aiFirewall.viewExternalLogs",
        "category": "AI Firewall",
        "title": "AI Firewall: View Audit Logs"
      },
      {
        "command": "aiFirewall.scanExtensions",
        "category": "AI Firewall",
        "title": "AI Firewall: Scan Installed Extensions for Risks"
      },
      {
        "command": "aiFirewall.acceptJump",
        "category": "AI Firewall",
        "title": "AI Firewall: Accept Jump Suggestion",
        "icon": "$(check)"
      },
      {
        "command": "aiFirewall.rejectJump",
        "category": "AI Firewall",
        "title": "AI Firewall: Reject Jump Suggestion",
        "icon": "$(close)"
      },
      {
        "command": "aiFirewall.generateRule",
        "category": "AI Firewall",
        "title": "Generate Rule",
        "icon": "$(shield)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.openInNewWindow",
        "category": "AI Firewall",
        "title": "Open in new window",
        "group": "AI Firewall"
      }
    ],
    "keybindings": [
      {
        "command": "aiFirewall.focusContinueInput",
        "mac": "cmd+l",
        "key": "ctrl+l"
      },
      {
        "command": "aiFirewall.focusContinueInputWithoutClear",
        "mac": "cmd+shift+l",
        "key": "ctrl+shift+l"
      },
      {
        "command": "aiFirewall.acceptDiff",
        "mac": "shift+cmd+enter",
        "key": "shift+ctrl+enter",
        "when": "aiFirewall.diffVisible"
      },
      {
        "command": "aiFirewall.rejectDiff",
        "mac": "shift+cmd+backspace",
        "key": "shift+ctrl+backspace",
        "when": "aiFirewall.diffVisible"
      },
      {
        "command": "aiFirewall.rejectDiff",
        "mac": "cmd+z",
        "key": "ctrl+z",
        "when": "aiFirewall.diffVisible"
      },
      {
        "command": "aiFirewall.quickEditHistoryUp",
        "mac": "up",
        "key": "up",
        "when": "false && aiFirewall.quickEditHistoryFocused"
      },
      {
        "command": "aiFirewall.quickEditHistoryDown",
        "mac": "down",
        "key": "down",
        "when": "false && aiFirewall.quickEditHistoryFocused"
      },
      {
        "command": "aiFirewall.acceptVerticalDiffBlock",
        "mac": "alt+cmd+y",
        "key": "alt+ctrl+y"
      },
      {
        "command": "aiFirewall.rejectVerticalDiffBlock",
        "mac": "alt+cmd+n",
        "key": "alt+ctrl+n"
      },
      {
        "command": "aiFirewall.focusEdit",
        "title": "Edit code with natural language",
        "mac": "cmd+i",
        "key": "ctrl+i"
      },
      {
        "command": "aiFirewall.exitEditMode",
        "mac": "escape",
        "key": "escape",
        "when": "aiFirewall.inEditMode && editorFocus"
      },
      {
        "command": "aiFirewall.debugTerminal",
        "mac": "cmd+shift+r",
        "key": "ctrl+shift+r"
      },
      {
        "command": "aiFirewall.openInNewWindow",
        "mac": "cmd+k cmd+m",
        "key": "ctrl+k ctrl+m",
        "when": "!terminalFocus"
      },
      {
        "command": "aiFirewall.toggleTabAutocompleteEnabled",
        "mac": "cmd+k cmd+a",
        "key": "ctrl+k ctrl+a",
        "when": "!terminalFocus"
      },
      {
        "command": "aiFirewall.forceAutocomplete",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "editorTextFocus && !editorHasSelection && !editorReadOnly && !inSnippetMode"
      },
      {
        "command": "aiFirewall.applyCodeFromChat",
        "mac": "alt+a",
        "key": "alt+a"
      },
      {
        "command": "aiFirewall.toggleNextEditEnabled",
        "key": "ctrl+k ctrl+n",
        "mac": "cmd+k cmd+n",
        "when": "editorTextFocus"
      },
      {
        "command": "aiFirewall.nextEditWindow.hideNextEditSuggestion",
        "key": "escape",
        "when": "editorTextFocus && nextEditWindowActive && !aiFirewall.jumpDecorationVisible"
      },
      {
        "command": "aiFirewall.nextEditWindow.acceptNextEditSuggestion",
        "key": "tab",
        "when": "editorTextFocus && nextEditWindowActive && !aiFirewall.jumpDecorationVisible"
      },
      {
        "command": "aiFirewall.acceptJump",
        "key": "tab",
        "when": "editorTextFocus && aiFirewall.jumpDecorationVisible"
      },
      {
        "command": "aiFirewall.rejectJump",
        "key": "escape",
        "when": "editorTextFocus && aiFirewall.jumpDecorationVisible"
      }
    ],
    "submenus": [
      {
        "id": "aiFirewall.aiFirewallSubMenu",
        "label": "AI Firewall"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aiFirewall.focusContinueInput"
        },
        {
          "command": "aiFirewall.focusContinueInputWithoutClear"
        },
        {
          "command": "aiFirewall.debugTerminal"
        },
        {
          "command": "aiFirewall.newSession"
        },
        {
          "command": "aiFirewall.enterEnterpriseLicenseKey"
        },
        {
          "command": "aiFirewall.generateRule"
        },
        {
          "command": "aiFirewall.openInNewWindow"
        }
      ],
      "editor/context": [
        {
          "submenu": "aiFirewall.aiFirewallSubMenu",
          "group": "0_acontinue"
        }
      ],
      "editor/title/run": [
        {
          "command": "aiFirewall.rejectDiff",
          "group": "AI Firewall",
          "when": "aiFirewall.streamingDiff"
        }
      ],
      "aiFirewall.aiFirewallSubMenu": [
        {
          "command": "aiFirewall.focusContinueInputWithoutClear",
          "group": "AI Firewall"
        },
        {
          "command": "aiFirewall.focusEdit",
          "group": "AI Firewall",
          "when": "!editorReadonly"
        }
      ],
      "explorer/context": [
        {
          "command": "aiFirewall.selectFilesAsContext",
          "group": "1_debug@1"
        }
      ],
      "view/title": [
        {
          "command": "aiFirewall.newSession",
          "group": "navigation@1",
          "when": "view == aiFirewall.aiFirewallGUIView"
        },
        {
          "command": "aiFirewall.viewHistory",
          "group": "navigation@2",
          "when": "view == aiFirewall.aiFirewallGUIView"
        },
        {
          "command": "aiFirewall.openConfigPage",
          "group": "navigation@4",
          "when": "view == aiFirewall.aiFirewallGUIView"
        },
        {
          "command": "aiFirewall.clearConsole",
          "group": "navigation@1",
          "when": "view == aiFirewall.aiFirewallConsoleView"
        }
      ],
      "editor/title": [
        {
          "command": "aiFirewall.newSession",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == aiFirewall.aiFirewallGUIView"
        },
        {
          "command": "aiFirewall.viewHistory",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == aiFirewall.aiFirewallGUIView"
        }
      ],
      "terminal/context": [
        {
          "command": "aiFirewall.debugTerminal",
          "group": "navigation@top"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiFirewall",
          "title": "AI Firewall",
          "icon": "media/sidebar-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "aiFirewallConsole",
          "title": "AI Firewall Console",
          "icon": "$(window)"
        }
      ]
    },
    "views": {
      "aiFirewall": [
        {
          "type": "webview",
          "id": "aiFirewall.aiFirewallGUIView",
          "name": "AI Firewall",
          "icon": "media/sidebar-icon.svg",
          "visibility": "visible"
        }
      ],
      "aiFirewallConsole": [
        {
          "type": "webview",
          "id": "aiFirewall.aiFirewallConsoleView",
          "name": "AI Firewall Console",
          "icon": "$(window)",
          "visibility": "visible",
          "when": "config.aiFirewall.enableConsole"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.continue*/config.json",
        "url": "./config_schema.json"
      },
      {
        "fileMatch": ".ai-firewallrc.json",
        "url": "./continue_rc_schema.json"
      },
      {
        "fileMatch": "**/config.yaml",
        "url": "./config-yaml-schema.json"
      }
    ]
  },
  "scripts": {
    "esbuild-base": "node scripts/esbuild.js",
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "esbuild-notify": "npm run esbuild-base -- --sourcemap --notify",
    "esbuild:visualize": "esbuild-visualizer --metadata ./build/meta.json --filename ./build/stats.html --open",
    "tsc": "tsc -p ./",
    "tsc:check": "tsc -p ./ --noEmit",

        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.fixCode",
        "category": "AI Firewall",
        "title": "Fix this Code",
        "icon": "$(wrench)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.optimizeCode",
        "category": "AI Firewall",
        "title": "Optimize this Code",
        "icon": "$(rocket)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.fixGrammar",
        "category": "AI Firewall",
        "title": "Fix Grammar / Spelling",
        "icon": "$(pencil)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.codebaseForceReIndex",
        "category": "AI Firewall",
        "title": "Codebase Force Re-Index",
        "icon": "$(sync)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.rebuildCodebaseIndex",
        "category": "AI Firewall",
        "title": "Rebuild codebase index",
        "icon": "$(database)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.docsIndex",
        "category": "AI Firewall",
        "title": "Docs Index",
        "icon": "$(list-tree)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.docsReIndex",
        "category": "AI Firewall",
        "title": "Docs Force Re-Index",
        "icon": "$(refresh)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.focusContinueInput",
        "category": "AI Firewall",
        "title": "Focus AI Firewall Chat",
        "icon": "$(comment-discussion)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.login",
        "category": "AI Firewall",
        "title": "Sign In",
        "icon": "$(sign-in)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.logout",
        "category": "AI Firewall",
        "title": "Sign Out",
        "icon": "$(sign-out)",
        "group": "AI Firewall"
      },
      {
        "command": "aiFirewall.enterEnterpriseLicenseKey",
        "category": "AI Firewall",
        "title": "Enter Enterprise License Key",
        "icon": "$(key)",
        "group": "AI Firewall"
      },
      {
